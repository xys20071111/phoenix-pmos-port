# Maintainer: phoenix-pmos-port (local only, NOT upstreamable)
# Venus video + modem (MPSS) firmware for Lenovo PHAB Plus PB1-770N.
# Blobs are proprietary stock files and MUST NOT be committed anywhere:
#
# venus (7 files, VIDEO.VE.1.8-00138, from the stock QPST system image):
#   /system/vendor/firmware/venus.{mdt,mbn,b00,b01,b02,b03,b04}
#
# modem (24 files, from the modem/NON-HLOS partition FAT image, see
#  fatread.py + backups/modem.bin):
#   fatread.py backups/modem.bin ls IMAGE          # -> MBA.MBN, MODEM.*
#   fatread.py backups/modem.bin extract IMAGE/X
#   (FAT names are uppercase; rename to lowercase after extracting)
#
# device-lenovo-phoenix depends on the -venus subpackage; install the
# -modem subpackage when enabling the modem (see BOOT-STATUS.md).
maintainer="Tom Xue <xys20071111@hotmail.com>"
pkgname=firmware-lenovo-phoenix
pkgver=1.0
pkgrel=1
pkgdesc="Stock firmware for Lenovo PHAB Plus (venus video + modem)"
url="https://github.com/xys20071111/phoenix-pmos-port"
license="proprietary"
arch="aarch64"
options="!check !strip !archcheck !tracedeps"
source="
	venus.mdt
	venus.mbn
	venus.b00
	venus.b01
	venus.b02
	venus.b03
	venus.b04
	mba.mbn
	modem.mdt
	modem.b00
	modem.b01
	modem.b02
	modem.b03
	modem.b04
	modem.b05
	modem.b06
	modem.b08
	modem.b09
	modem.b12
	modem.b13
	modem.b14
	modem.b15
	modem.b16
	modem.b17
	modem.b18
	modem.b21
	modem.b22
	modem.b23
	modem.b25
	modem.b26
	"
subpackages="$pkgname-venus $pkgname-modem"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

venus() {
	pkgdesc="$pkgdesc (venus video decoder/encoder)"
	install -Dm644 "$srcdir"/venus.mdt "$srcdir"/venus.mbn \
		"$srcdir"/venus.b00 "$srcdir"/venus.b01 "$srcdir"/venus.b02 \
		"$srcdir"/venus.b03 "$srcdir"/venus.b04 \
		-t "$subpkgdir"/usr/lib/firmware/qcom/venus-1.8/
}

# Names match what drivers/remoteproc/qcom_q6v5_mss (MSS_MSM8916 desc)
# requests via request_firmware: mba.mbn + modem.mdt + modem.bNN.
modem() {
	pkgdesc="$pkgdesc (baseband / MPSS)"
	install -Dm644 "$srcdir"/mba.mbn "$srcdir"/modem.mdt \
		"$srcdir"/modem.b00 "$srcdir"/modem.b01 "$srcdir"/modem.b02 \
		"$srcdir"/modem.b03 "$srcdir"/modem.b04 "$srcdir"/modem.b05 \
		"$srcdir"/modem.b06 "$srcdir"/modem.b08 "$srcdir"/modem.b09 \
		"$srcdir"/modem.b12 "$srcdir"/modem.b13 "$srcdir"/modem.b14 \
		"$srcdir"/modem.b15 "$srcdir"/modem.b16 "$srcdir"/modem.b17 \
		"$srcdir"/modem.b18 "$srcdir"/modem.b21 "$srcdir"/modem.b22 \
		"$srcdir"/modem.b23 "$srcdir"/modem.b25 "$srcdir"/modem.b26 \
		-t "$subpkgdir"/lib/firmware/
}

