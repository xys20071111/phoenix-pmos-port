+/*
+ * Frame-based write master geometry, mirroring the stock qcom msm_isp40
+ * driver: WR_BUFFER_CFG carries (8-byte groups per line << 16) |
+ * ((height - 1) << 4) | AXI burst length also for frame-based streams,
+ * and a single active RDI write master owns the entire image unbounded
+ * buffer (16-byte units; 1656 for msm8916, 2680 for msm8939). Leaving
+ * either register at its reset value makes the write master skip every
+ * second burst, ending up with every other 1 KiB block of the frame
+ * buffer missing.
+ */
+static void vfe_wm_set_frame_based_geometry(struct vfe_device *vfe, u8 wm,
+					    const struct v4l2_pix_format_mplane *pix)
+{
+	bool msm8939;
+	u16 wpl;
+	u32 ub_size;
+	u32 reg;
+
+	/*
+	 * The unbounded buffer size differs per SoC and is not in the main
+	 * resource tables; identify the SoC by the top-level CAMSS node
+	 * compatible.
+	 */
+	msm8939 = vfe->camss->dev && vfe->camss->dev->of_node &&
+		  of_device_is_compatible(vfe->camss->dev->of_node,
+					  "qcom,msm8939-camss");
+	ub_size = msm8939 ? 2680 : 1656;
+	writel_relaxed(ub_size - 1,
+		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_UB_CFG(wm));
+
+	switch (pix->pixelformat) {
+	case V4L2_PIX_FMT_SBGGR10P:
+	case V4L2_PIX_FMT_SGBRG10P:
+	case V4L2_PIX_FMT_SGRBG10P:
+	case V4L2_PIX_FMT_SRGGB10P:
+		wpl = (pix->width * 5 + 31) / 32;
+		break;
+	default:
+		return;
+	}
+
+	/* Burst length 3 matches the stock VFE40_BURST_LEN_8916_VERSION. */
+	reg = ((u32)wpl << 16) | ((u32)(pix->height - 1) << 4) | 0x3;
+	writel_relaxed(reg, vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_BUFFER_CFG(wm));
+}
