+/*
+ * Stock msm_vfe40_init_hardware_reg() programs three hand-over tables the
+ * mainline driver never touches: the bus bridge QOS remapper (0x2c4..0x2e0,
+ * 0xaaa5aaa5 / 0x0001aaa5), the DS (delay-share) table 0x988..0x9c8 and the
+ * VFE bus fabric ("VBIF") write-family configuration on the separate
+ * vfe0_vbif mapping (0x30 = 0xfff, 0x34 = 0x00555000; values from the
+ * msm8939-camera.dtsi qos/vbif/ds tables). With the fabric left at reset
+ * values the RDI write master loses every second burst into the frame
+ * buffer (measured: strictly 2048 B periodic holes, independent of all
+ * VFE write master registers). Idempotent, safe to re-run per power-on.
+ */
+static void vfe_configure_bus_fabric(struct vfe_device *vfe)
+{
+	int i;
+
+	writel_relaxed(VFE_0_BUS_BDG_QOS_CFG_0_CFG,
+		       vfe->base + VFE_0_BUS_BDG_QOS_CFG_0);
+	writel_relaxed(VFE_0_BUS_BDG_QOS_CFG_0_CFG,
+		       vfe->base + VFE_0_BUS_BDG_QOS_CFG_1);
+	writel_relaxed(VFE_0_BUS_BDG_QOS_CFG_0_CFG,
+		       vfe->base + VFE_0_BUS_BDG_QOS_CFG_2);
+	writel_relaxed(VFE_0_BUS_BDG_QOS_CFG_0_CFG,
+		       vfe->base + VFE_0_BUS_BDG_QOS_CFG_3);
+	writel_relaxed(VFE_0_BUS_BDG_QOS_CFG_0_CFG,
+		       vfe->base + VFE_0_BUS_BDG_QOS_CFG_4);
+	writel_relaxed(VFE_0_BUS_BDG_QOS_CFG_0_CFG,
+		       vfe->base + VFE_0_BUS_BDG_QOS_CFG_5);
+	writel_relaxed(VFE_0_BUS_BDG_QOS_CFG_0_CFG,
+		       vfe->base + VFE_0_BUS_BDG_QOS_CFG_6);
+	writel_relaxed(VFE_0_BUS_BDG_QOS_CFG_7_CFG,
+		       vfe->base + VFE_0_BUS_BDG_QOS_CFG_7);
+
+	for (i = VFE_0_BUS_DS_CFG_BASE; i <= VFE_0_BUS_DS_CFG_LAST - 4; i += 4)
+		writel_relaxed(VFE_0_BUS_DS_CFG_VAL, vfe->base + i);
+	writel_relaxed(VFE_0_BUS_DS_CFG_LAST_VAL,
+		       vfe->base + VFE_0_BUS_DS_CFG_LAST);
+
+	if (vfe->base_vbif) {
+		writel_relaxed(0x00000fff, vfe->base_vbif + 0x30);
+		writel_relaxed(0x00555000, vfe->base_vbif + 0x34);
+	}
+}
