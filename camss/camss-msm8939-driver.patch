+/*
+ * MSM8939 has three CSIDs but a single VFE: every CSID is parented to
+ * VFE0 regardless of its id, so map all CSIDs onto VFE0 for power and
+ * clock control. (Upstream's vfe_parent_dev_ops maps CSID id -> VFE id,
+ * which leaves CSID1/2 unpowerable on single-VFE SoCs.)
+ */
+static int vfe0_parent_dev_ops_get(struct camss *camss, int id)
+{
+	return vfe_get(&camss->vfe[0]);
+}
+
+static int vfe0_parent_dev_ops_put(struct camss *camss, int id)
+{
+	vfe_put(&camss->vfe[0]);
+
+	return 0;
+}
+
+static void __iomem *
+vfe0_parent_dev_ops_get_base_address(struct camss *camss, int id)
+{
+	return camss->vfe[0].base;
+}
+
+static const struct parent_dev_ops vfe0_parent_dev_ops = {
+	.get = vfe0_parent_dev_ops_get,
+	.put = vfe0_parent_dev_ops_put,
+	.get_base_address = vfe0_parent_dev_ops_get_base_address
+};
+
