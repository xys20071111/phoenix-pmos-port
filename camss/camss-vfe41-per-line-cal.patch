+static uint pix_front_wb_gain_r = 260;	/* 2.03 */
+static uint pix_front_wb_gain_g = 128;	/* 1.00 */
+static uint pix_front_wb_gain_b = 163;	/* 1.27 */
+module_param_named(pix_front_wb_gain_r, pix_front_wb_gain_r, uint, 0644);
+module_param_named(pix_front_wb_gain_g, pix_front_wb_gain_g, uint, 0644);
