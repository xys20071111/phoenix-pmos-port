+/*
+ * Which ISPIF line is armed into the PIX sink pad right now (media
+ * controller link state, sampled on every stream-on)?  In this topology
+ * only ISPIF line source pads link into VFE line sink pads, and
+ * v4l2_get_subdevdata() on an ISPIF line subdev is its struct ispif_line.
+ * Line 0 = the CSIPHY0/CSID0 rear chain, line 1 = the CSIPHY1/CSID1 front
+ * chain (msm8939 wiring); no armed link (idle) falls back to the shared
+ * set, which changes nothing because no stream is being built either.
+ */
+static bool vfe_bayer_pix_is_front(struct vfe_device *vfe)
+{
+	struct media_pad *pad;
+	struct v4l2_subdev *sd;
+	struct ispif_line *iline;
+
+	pad = media_pad_remote_pad_first(
+			&vfe->line[VFE_LINE_PIX].pads[MSM_VFE_PAD_SINK]);
+	if (!pad || !pad->entity)
+		return false;
+
+	sd = media_entity_to_v4l2_subdev(pad->entity);
+	iline = v4l2_get_subdevdata(sd);
+
+	return iline && iline->id == 1;
+}
+
+/* Resolve the WB gain set for the currently armed PIX source chain. */
+static void vfe_bayer_wb_gains(struct vfe_device *vfe, unsigned int *r,
+			       unsigned int *g, unsigned int *b)
+{
+	if (vfe_bayer_pix_is_front(vfe)) {
+		*r = pix_front_wb_gain_r;
+		*g = pix_front_wb_gain_g;
+		*b = pix_front_wb_gain_b;
+	} else {
+		*r = pix_wb_gain_r;
+		*g = pix_wb_gain_g;
+		*b = pix_wb_gain_b;
+	}
+}
+
+/* Colour-matrix selection, per armed PIX source chain. */
+static uint vfe_bayer_cc_mode(struct vfe_device *vfe)
+{
+	return vfe_bayer_pix_is_front(vfe) ? pix_front_cc_mode : pix_cc_mode;
+}
