+/* Standby control register; the stock singleton writes 0x0a
+ * (sensor standby + MIPI standby) around the table pass and
+ * releases it from its own flow.  r86-F writes the table without
+ * the singleton and releases the standby bit right after (so the
+ * later 0100=1 stream-on actually emits frames). */
+#define OV5693_REG_STANDBY			CCI_REG8(0x3001)
