+static bool pm8916_bms_vm_valid_ocv(unsigned int ocv)
+{
+	return ocv >= 2500000 && ocv <= 4600000;
+}
+
+/*
+ * Return the local slope of the OCV table in uV per percent. This is used
+ * to convert a charge delta into an OCV delta.
+ */
+static int pm8916_bms_vm_ocv_slope(struct pm8916_bms_vm_battery *bat,
+				   unsigned int ocv)
+{
+	struct power_supply_battery_ocv_table *table;
+	int i, len, idx = -1;
+	int docv, dcap;
+
+	table = power_supply_find_ocv2cap_table(bat->info, 25, &len);
+	if (!table || len < 2)
+		return 0;
+
+	for (i = 0; i < len - 1; i++) {
+		if (ocv <= table[i].ocv && ocv >= table[i + 1].ocv) {
+			idx = i;
+			break;
+		}
+	}
+
+	if (idx < 0)
+		idx = ocv > table[0].ocv ? 0 : len - 2;
+
+	docv = table[idx].ocv - table[idx + 1].ocv;
+	dcap = table[idx].capacity - table[idx + 1].capacity;
+	if (docv <= 0 || dcap <= 0)
+		return 10000;
+
+	return max_t(int, docv / dcap, 500);
+}
+
+static void pm8916_bms_vm_update_vbat(struct pm8916_bms_vm_battery *bat,
+				      unsigned int vbat_uv, s64 dt_ms)
+{
+	if (!bat->vbat_valid) {
+		bat->vbat_now = vbat_uv;
+		bat->vbat_valid = true;
+		return;
+	}
+
+	bat->vbat_now += div_s64(((s64)vbat_uv - (s64)bat->vbat_now) * dt_ms,
+				 (s32)(PM8916_BMS_VM_VBAT_TAU_MS + dt_ms));
+}
+
+/*
+ * Estimate the open circuit voltage from the terminal voltage.
+ *
+ * The battery current is approximated with I = (OCV - VBAT) / Rbatt, i.e.
+ * the voltage dropped over the (known) internal resistance. That current is
+ * then integrated into the OCV, moving it along the OCV table. This has two
+ * important properties compared to simply using VBAT:
+ *
+ *  - a load step only changes I for as long as the load lasts, it does not
+ *    move the OCV (and therefore the capacity) instantly;
+ *  - when the load is removed VBAT rises towards the OCV and I goes to zero,
+ *    so the capacity does not jump back up either.
+ *
+ * The observer converges towards the real OCV with a time constant of
+ * Rbatt * Q / (dOCV/dSoC), which is roughly half an hour for this battery.
+ * Rbatt only scales that time constant; it does not change the equilibrium.
+ * While a load is sustained the equilibrium is the loaded voltage, so a
+ * plausible Rbatt still matters, but a load step or a rest no longer
+ * produces a capacity jump.
+ */
+static void pm8916_bms_vm_update_ocv(struct pm8916_bms_vm_battery *bat,
+				     s64 dt_ms)
+{
+	s64 ir_uv, docv_uv, new_ocv;
+	int slope;
+
+	ir_uv = (s64)bat->ocv_now - (s64)bat->vbat_now;
+
+	slope = pm8916_bms_vm_ocv_slope(bat, bat->ocv_now);
+	if (!slope)
+		return;
+
+	/*
+	 * ir in uV, Rbatt in uOhm -> current in A. Integrating:
+	 *
+	 *   dOCV[uV] = (ir[uV] / Rbatt[uOhm]) * dt[ms] / (Q[uAh] * 3600 * 1000)
+	 *              * 100 * slope[uV/%]
+	 *            = ir * dt * slope * 250 / (9 * Rbatt * Q)
+	 */
+	docv_uv = (s64)ir_uv * dt_ms * 250 * slope;
+	docv_uv = div64_s64(docv_uv,
+			    (s64)9 * bat->rbatt_uohm * bat->capacity_uah);
+
+	new_ocv = (s64)bat->ocv_now - docv_uv;
+	new_ocv = clamp(new_ocv, (s64)PM8916_BMS_VM_OCV_MIN_UV,
+			(s64)bat->info->voltage_max_design_uv);
+	bat->ocv_now = new_ocv;
+}
+
+/*
+ * The capacity is derived from the OCV estimate. Slew limit the reported
+ * value so that nothing the observer does can produce a visible jump.
+ */
+static void pm8916_bms_vm_update_capacity(struct pm8916_bms_vm_battery *bat,
+					  s64 dt_ms)
+{
+	s64 raw_upct, diff, adiff, step;
+	int raw;
+
+	raw = power_supply_batinfo_ocv2cap(bat->info, bat->ocv_now, 25);
+	if (raw < 0)
+		return;
+
+	raw = clamp(raw, 0, 100);
+	raw_upct = (s64)raw * 1000000;
+
+	if (bat->reported_cap_upct < 0) {
+		bat->reported_cap_upct = raw_upct;
+		return;
+	}
+
+	diff = raw_upct - bat->reported_cap_upct;
+	adiff = diff < 0 ? -diff : diff;
+
+	if (adiff > PM8916_BMS_VM_CAP_CATCHUP_THRESHOLD_UPCT)
+		step = dt_ms * PM8916_BMS_VM_CAP_CATCHUP_UPCT_PER_S / 1000;
+	else
+		step = dt_ms * PM8916_BMS_VM_CAP_SLEW_UPCT_PER_S / 1000;
+	if (step < 1)
+		step = 1;
+
+	diff = clamp(diff, -step, step);
+	bat->reported_cap_upct += diff;
+	bat->reported_cap_upct = clamp(bat->reported_cap_upct,
+				       0, 100LL * 1000000);
+}
+
+/*
+ * The PMIC preserves OCV/SoC in two registers across reboots (Android/TWRP
+ * use the same ones). Refresh them every few seconds so the next boot -
+ * including a reboot into recovery - starts from our latest value.
+ */
+static void pm8916_bms_vm_backup(struct pm8916_bms_vm_battery *bat, u64 now_ns)
+{
+	u16 ocv_mv;
+	int cap, ret;
+
+	if (bat->backup_failed || !bat->ocv_valid || bat->reported_cap_upct < 0)
+		return;
+	if (now_ns - bat->last_backup_ns < PM8916_BMS_VM_BACKUP_INTERVAL_NS)
+		return;
+
+	ocv_mv = (u16)clamp(bat->ocv_now / 1000, 2500, 4600);
+	cap = clamp(div_s64(bat->reported_cap_upct, 1000000), 0, 100);
+
+	ret = regmap_bulk_write(bat->regmap,
+				bat->reg + PM8916_BMS_VM_OCV_BACKUP_REG,
+				&ocv_mv, 2);
+	if (!ret)
+		ret = regmap_update_bits(bat->regmap,
+					 bat->reg + PM8916_BMS_VM_SOC_BACKUP_REG,
+					 PM8916_BMS_VM_SOC_BACKUP_MASK,
+					 (cap + 1) << 1);
+	if (ret) {
+		dev_warn(bat->dev, "Failed to store OCV/SOC backup: %d\n", ret);
+		bat->backup_failed = true;
+		return;
+	}
+
+	bat->last_backup_ns = now_ns;
+}
