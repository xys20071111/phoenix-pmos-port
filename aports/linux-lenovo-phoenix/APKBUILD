# Kernel config based on: arch/arm64/configs/msm8916_defconfig
#
# phoenix fork of device/testing/linux-postmarketos-qcom-msm8916 (2026-10): this
# is the SAME kernel source + patch set that previously lived as local
# modifications of the generic qcom-msm8916 kernel package, split out so the
# upstream generic package can stay pristine. Content and pkgrel numbering
# continue from linux-postmarketos-qcom-msm8916 pkgrel=82 (= device kernel
# build #83); the historical notes below keep those numbers.
maintainer="Tom Xue <xys20071111@hotmail.com>"
_flavor="lenovo-phoenix"
pkgname=linux-$_flavor
pkgver=6.12.1
# Local phoenix port (NOT upstream): adds msm8939-lenovo-phoenix.dts and
# panel-novatek-nt35532.c. Drop these when they land in msm8916-mainline/linux.
# r60: smb358 read-only status driver replaced by mainline CHARGER_SMB347
# (same compatible would race); DTS gains summit,enable-usb-charging +
# usb-vbus regulator child (OTG precursor, see repo otg/OTG.md).
# r61: smb347-smb358-input-detect.patch — SMB358 diverges from SMB347 in
# IRQSTAT_E (no separate input-UV IRQ latch; BIT0 *is* the live event) so
# the cached usb_online froze at probe value; also enables the INOK
# (input-OK) STATUS_IRQ latch so cable insertion wakes the handler, and
# acknowledges IRQSTAT_A/B/F latches that otherwise keep the STAT pin
# asserted (25/s re-fire loop on the device).
# r62: charger IRQ LEVEL_LOW -> EDGE_BOTH: this board's STAT pin stays
# asserted low at ~27/s across handler runs even with every latch
# acknowledged (verdict: idle-level low, not a missed ack; the old
# read-only driver ran the same line on edges for weeks without CPU
# churn since TLMM edge trigger counts one edge for a held line).
# r61 verified on device: online follows plug/unplug, usb_vbus
# regulator present (regulator.22), RNDIS unaffected.
# r62 verified on device: idle IRQ count no longer grows.
# r63: ST2 — &usb gains vbus-supply = <&usb_vbus> (SMB358 boost drives
# OTG VBUS through CMD_A bit4 when ci_hdrc host role enables it).
# r63 on device: host role started (EHCI root hub) but the keyboard got
# no VBUS, and gadget/RNDIS died on cable attach. Charging OK. Cable
# events stopped reaching the IRQ (EDGE_BOTH count = 2 total since boot;
# the idle-low pulsing seen at r60-r62 happens when no input present) —
# on this board the SMB358 INOK pin appears tied such that in absence
# of external input INOK is active, which per the driver suppresses the
# OTG boost output ("VBUS won't be powered if INOK is active").
# r64: enable the INOK toggle around OTG output mode: DTS gains
# summit,needs-inok-toggle (usb-vbus child) + summit,inok-polarity = LOW
# (upstream binding canonical pair, also fixes IRQSTAT_F latch wakeups
# for charge detection when no cable initially).
# r61 camera rounds: camss-vfe41-frame-based-geometry.patch — the mainline
# VFE4.1 RDI path leaves WR_BUFFER_CFG at reset (0) for frame-based write
# masters while the stock msm_isp40 programs it; live mid-stream reads
# confirmed 0x00000000 on-device and frames arrive with every other 1 KiB
# block skipped (half the bytes zero). The new optional gen1 op mirrors
# the stock geometry calculation (8-byte groups per line | height | burst 3).
# r62: WR_BUFFER_CFG now reads back the predicted 0x014A61F3 mid-stream yet
# the skip pattern is unchanged (frame-row write stride is 2560 B not 2640,
# phase drifts -80 B/row), so the op also reallocates the image unbounded
# buffer to full stock parity (msm_isp40 single active RDI master: 2680
# 16-byte units on msm8939, 1656 on msm8916; mainline leaves 341).
# r63: UB 0x00000A77 reads back but the skip skeleton stays identical -
# measured it is a strictly linear, row-structure-free 2048 B periodic
# half-skip independent of every write master register. The remaining
# stock hand-over the mainline driver never programs is the bus fabric
# (msm8939-camera.dtsi): BUS_BDG QOS 0x2c4..0x2e0, DS table 0x988..0x9c8
# and VBIF 0x30/0x34; add vfe_configure_bus_fabric() for parity (+ the
# optional vfe0_vbif mapping hook).
# r86 front-camera full-stock mode (ov5693-stock-24m.patch, pkgrel 80→81):
# "plan B" for the front OV5693 after the r85 stream_regs bisect campaign on
# kernel #81 turned out fully negative (R1 sanity reproduced the #78
# signature; R2a-e/R3/R5/R6a-c all dead; R4a stock-PLL-5-pairs at 19.2 MHz
# MCLK DEGRADED the link to total=1 = the stock PLL block belongs to 24 MHz
# MCLK). Switches the whole front camera to the stock "sunny_q5v41b" module
# state: DTS MCLK1 assigned rate 19.2 MHz → 24 MHz and endpoint
# link-frequencies 419.2 MHz → 400 MHz (stock lane rate = 24 MHz x 0x30b3/0x30b4
# = 24 x 100 / 3 = 800 Mbps/lane), driver XVCLK check 19.2 → 24 MHz, menu and
# check_hwcfg to 400 MHz, FIXED_PPL 2688 → 2672 (stock HTS 0x0a70) and
# PIXEL_RATE to the stock 159048960 (2672x1984x30, so vblank max = stock VTS
# 0x7c0 = 1984). At every stream-on the full verbatim stock libmmcamera
# m0 res_settings (255 entries after stripping the {0x0103,0x01} sw-reset
# head and the {0x3001,0x0a} standby singleton; standby is released
# explicitly after the table) is written BEFORE the ctrl/AEC handler
# flush and stream-on, mirroring the stock daemon order and the r61-r82
# ov13850 driver pattern. stream_regs override mechanism stays fully
# available (it runs after the stock table by design).
# r83 front-camera runtime register overrides (ov5693-stream-regs.patch, pkgrel 79→80):
# diagnostic-only. Adds a module param `stream_regs` (comma separated
# REG=VAL hex pairs) written at every stream start, after the global table and
# mode configuration, before 0x0100=1. Empty by default = current behaviour.
# r84 BUGFIX: apply_stream_regs returns the number of pairs written (a
# positive count); that return value flowed into cci_write's *err accumulator,
# so v4l2-cci skipped the SW_STREAM (0x0100=1) write and the sensor never
# entered streaming for ANY override (observed on-device: 0x0100=0, CSID
# counters all zero even for a no-op override like 5e00=80). Reset ret=0
# between the override pass and the SW_STREAM cci_write (same lesson as the
# r61 ov13850 unconditional-ret fix).
# Purpose: bisect the remaining front-camera MIPI output problem (no RAW10
# long packets reach CSID; 0x4307=0x31 made pixel-sized packets with an
# unmapped generic DT appear, 0x4307=0x30 = stock value removes them) across
# the stock register table without a rebuild per candidate.
# r82 front-camera MIPI data-type fix (ov5693-4307-stock.patch, pkgrel 78):
# the front OV5693 real stream was sending CSI-2 long packets with data type
# 0x12 instead of RAW10 0x2B (decoded from CSID unmapped_hdr=0x120ca834:
# DT=0x12, WC=0x0CA8=3240 = one 2592x10b line), so the CSID LUT (0x2B) never
# mapped them and no frame reached VFE. Mainline's mode table wrote
# reg 0x4307=0x31 while the stock module/tables use 0x4307=0x30 - the only
# known sensor-config delta. This patch writes the stock value.
# r81 front payload diagnostics (camss-front-payload-diag.patch, pkgrel 77):
# incremental on camss-front-instrumentation.patch. Exposes the CSID data
# plane that stock knows but never reads: total_pkts/ECC/CRC (0x90/0x94/0x98),
# captured long/short headers (0x6C/0x70/0x74/0x78/0x7C), PIF MISR (0x80-0x8C),
# IRQ_MASK + raw IRQ status, snapshotted at stream-on/+100ms/stream-off; plus
# gated stock-parity A/Bs csid_irq_mask, csid_short_pkt_reset,
# csiphy1_settle, csiphy1_rev3_quirk, ispif_stock_init (defaults unchanged).
# Context: frame-start (RDI0 SOF) reaches VFE at 30 fps but no payload does,
# and no CSID/ISPIF/CSIPHY programming difference vs stock remains.
# Also in this build: pix_full_isp now defaults to 2 (B2 full ISP, true YCbCr
# colour); set pix_full_isp=0 at runtime for the legacy demux-only path.
# r89 front-camera ISP tuning (camss-vfe41-per-line-cal.patch, pkgrel 81→82):
# r89 proved the front OV5693 streams through the SAME SINGLE VFE PIX line
# with zero kernel changes (arm "msm_ispif1"->"msm_vfe0_pix" via media
# controller; B2 hardware ISP output captured at 2592x1944 NV12, TP
# B2_PASS + wall |U-V|=0.39 after calibration). The two sensors do need
# different Stage-B parameters though (shared module params are
# OV13850-tuned: WB 246/128/172 + TL84 colour matrix; OV5693 calibrates to
# WB 260/128/163 with an identity matrix). This patch adds per-source
# selection: at stream-on the armed media link into the PIX sink pad
# ("msm_ispif0" rear chain vs "msm_ispif1" front chain) picks which set
# vfe_set_wb_cfg/demosaic_interp/cc_cfg program; new runtime params
# pix_front_wb_gain_{r,g,b} (defaults 260/128/163) and pix_front_cc_mode
# (default 0 = identity), shared params unchanged for the rear.
# r80 rear Stage-B full ISP (camss-vfe41-pix-full-isp.patch, pkgrel 76):
# incremental on pix-bayer v2; programs the VFE4.1 bayer ISP chain (demosaic,
# WB, colour correction, chroma-enhance/RGB->YUV) plus optional LINEARIZATION
# BLC (11+36-word tables incl. DMI LUT bank0). All gated by module params and
# OFF by default: pix_full_isp 0/1(B1)/2(B2)/3(B2+BLC), pix_linearization,
# pix_full_isp_cfg, pix_wb_gain_r/g/b, pix_demosaic_interp, pix_cc_mode,
# pix_cc_qfactor, pix_ce_mode. Default behaviour = previous demux-only path.
# r77 front-camera diagnostics (camss-front-instrumentation.patch, pkgrel 75):
# temporary, drop before upstreaming. Default behaviour unchanged; adds
# stream-on dev_info readbacks (CSID CORE_CTRL_0/1 + CID LUT/CFG, CSIPHY1
# lane mask/positions/settle, ISPIF INTF_INPUT_SEL/INTF_CMD_0/RDI0 CID) and
# runtime A/B params csid_lane_assign/csid_lane_cnt/csid_core_ctrl1_lo,
# csiphy1_lane_pos/cnt, plus ov5693 stock_mipi_regs. Reason: the front OV5693
# real stream delivers MIPI data to CSID1 but never a frame boundary to VFE;
# stock CSID/ISPIF programming is register-equivalent to mainline, so the
# remaining hypotheses are the CSIPHY lane map / CSID lane config, which this
# build makes observable and overridable without /dev/mem MMIO.
# r76 (PIX): camss-msm8939-driver.patch now defines vfe_res_8x39 with
# line_num = 4 (CAMSS_8x16 vfe_ops_4_1 supports the PIX line natively:
# msm_vfe0_pix subdev + msm_vfe0_video3 NV12 node appear automatically via
# camss_link_entities). camss-vfe41-pix-bayer.patch adds the raw-bayer
# branches the gen1 driver never had (CORE_CFG CAMIF pixel patterns
# 0x0-0x3 per the downstream ISP_START_PIXEL_PATTERN enum order, a demux
# bayer branch with runtime-tunable selector/gain module params, and
# SBGGR10_* entries in formats_pix_8x16 so the video node maps the raw
# sink to NV12). The demux bayer selector constants are first guesses
# (no public reference exists - the stock camera HAL programs them via
# MSM_VFE_REG_CFG ioctls); enumerate via
# /sys/module/qcom_camss/parameters/demux_{even,odd} without rebuilds.
# r83 venus v9 wiring (2026-10-25, pkgrel 82->83, PENDING device test): swaps
# in the repo's "venus v9 final shape" for venus-msm8939-res.patch +
# venus-v1-vcodec-clks.patch (repo commit 69b09c7). Functional delta vs the
# shape that ran r60..r82: core_clks_set_rate() now rate-programs
# GCC_VENUS0_CORE1_VCODEC0_CLK too (the old shape filled vcodec1_clks[0] with
# a second "vcodec0_core" entry, so the second subcore clock never got
# set_rate and stayed at its boot rate); the enabled clock set is unchanged,
# only the fail-unwind labels differ.
# r84 battery gauge (2026-10-26, pkgrel 83->84): replaces
# pm8916-bms-vm-fake-ocv-snap.patch with pm8916-bms-vm-ocv-observer.patch.
# The VM-BMS has no current sense; the old code fed the loaded terminal
# voltage to the OCV table, so any load step (or unplug, 4.35V float ->
# OCV) collapsed the percentage in seconds and rest bounced it back.
# The observer estimates I = (OCV - VBAT) / Rbatt and integrates it into
# the OCV, so only real charge movement changes the displayed value.
# Rbatt comes from the battery node (factory-internal-resistance-micro-ohms,
# 126 mOhm = downstream qcom,default-rbatt-mohm).
# r85 battery boot anchor (2026-10-27, pkgrel 84->85): the phone can run for
# days without suspending, so the S3 OCV read at probe could be from the last
# suspend (often a charging float, 4.35V) -> every reboot showed 100%. Do not
# use S3 at boot any more: start from the terminal voltage (+IR allowance) and
# refine with the highest terminal voltage seen during the first minute.
# Suspend skips forcing S3 while charging (Android qpnp-vm-bms does the same)
# and resume only re-anchors if S3 was actually measured.
# r86 charge current (2026-10-27, pkgrel 85->86): the battery node now carries
# the downstream fast-charge profile (1.8A FCC, 100mA termination), which the
# smb347 driver programs into the SMB358; without it the chip keeps its OTP
# default and charges very slowly. The BMS boot-while-charging IR estimate also
# uses this FCC instead of a blind 100mV (1.8A * 126mOhm = 227mV).
# r87 VBAT offset + full-charge boot anchor (2026-10-28, pkgrel 86->87):
# the VM-BMS raw VBAT reads ~100mV high on this board (at the SMB358 4.34V
# float the averaged FIFO value is ~4.448V), so restore the offset that the
# original fork hack applied. The boot-while-charging OCV init also applied
# the 1.8A FCC IR margin even after EOC (anchored full at ~87%); only use it
# while the charger reports CHARGING, use 0 for FULL/NOT_CHARGING.
# r88 TWRP alignment (2026-10-28, pkgrel 87->88): use the PMIC-backed
# shutdown OCV/SoC registers (B1..B2 in mV, B0 = (soc+1)<<1) that Android and
# TWRP write: read them at probe and refresh them every 10s, so a reboot
# starts from the last real value (TWRP 97% == stored OCV 4.28V) instead of a
# guess. If missing/inconsistent, fall back to the S3 OCV (|OCV-VBAT| <=
# 400mV) and finally to the terminal voltage + IR.
pkgrel=88
# When making kernel config changes, keep this fork's config self-contained:
# there is no pmos.config PR target like the generic package had, but please
# mirror any still-relevant change upstream when the feature is upstreamed.
# pkgver upgrades regenerate the config from the msm8916-mainline/linux tag
# and all local CONFIG_ changes below must be re-applied by hand!
pkgdesc="Mainline kernel fork for the Lenovo PHAB Plus (phoenix, MSM8939)"
arch="aarch64"
url="https://github.com/msm8916-mainline/linux"
license="GPL-2.0-only"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-uefi
"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"
# NOTE: not using replaces= ("linux-postmarketos-qcom-msm8909/msm8939") like the
# generic package — this fork must never shadow the upstream generic kernels.

# Architecture
case "$CARCH" in
	aarch64) _carch="arm64" ;;
esac

# Source
# NOTE: the tarball distfile keeps the upstream package name on purpose: it is
# the exact same msm8916-mainline/linux tarball already sitting in
# cache_distfiles, so the fork builds without re-downloading ~230 MB and the
# checksum below stays valid.
_tag=v${pkgver//_/-}-msm8916
source="
	linux-postmarketos-qcom-msm8916-v6.12.1-msm8916.tar.gz::$url/archive/$_tag.tar.gz
	config-$_flavor.aarch64
	0001-kbuild-Add-fno-builtin-wcslen.patch
	smb347-smb358-input-detect.patch
	smb347-smb358-otg-i2c-mode.patch
	msm8939-lenovo-phoenix.dts
	panel-novatek-nt35532.c
	panel-novatek-nt35532.kconfig
	qcom-pon.c
	ov13850.c
	ov13850.kconfig
	pm8916-bms-vm-ocv-observer.patch
	qcom-iommu-resv-regions.patch
	venus-msm8939-res.patch
	venus-v1-vcodec-clks.patch
	gcc-msm8939-venus-trigger.patch
	gcc-msm8939-camss-mclk.patch
	qcom-bam-dmux-register-netdevs.patch
	camss-msm8939-driver.patch
	msm8939-camss-dtsi.patch
	ov5693-bringup-retry.patch
	camss-vfe41-frame-based-geometry.patch
	camss-vfe41-pix-bayer.patch
	camss-front-instrumentation.patch
	camss-vfe41-pix-full-isp.patch
	camss-vfe41-per-line-cal.patch
	camss-front-payload-diag.patch
	ov5693-4307-stock.patch
	ov5693-stream-regs.patch
	ov5693-stock-24m.patch
	qcom-msm8939-camss.yaml
"
builddir="$srcdir/linux-${_tag#v}"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
	# Local phoenix port (NOT upstream): install DTS + NT35532 panel driver
	# until they land in msm8916-mainline/linux (then drop this whole block).
	cp "$srcdir/msm8939-lenovo-phoenix.dts" arch/arm64/boot/dts/qcom/
	grep -q "msm8939-lenovo-phoenix.dtb" arch/arm64/boot/dts/qcom/Makefile || \
	sed -i 's|dtb-$(CONFIG_ARCH_QCOM)\t+= msm8939-longcheer-l9100.dtb|dtb-$(CONFIG_ARCH_QCOM)\t+= msm8939-lenovo-phoenix.dtb\n&|' \
		arch/arm64/boot/dts/qcom/Makefile
	# panel-novatek-nt35532: phoenix NT35532 (generic-write init seq from
	# downstream qcom,mdss-dsi-on-command), not yet in the 6.12.1 tree.
	cp "$srcdir/panel-novatek-nt35532.c" drivers/gpu/drm/panel/
	grep -q "DRM_PANEL_NOVATEK_NT35532" drivers/gpu/drm/panel/Makefile || \
	echo 'obj-$(CONFIG_DRM_PANEL_NOVATEK_NT35532) += panel-novatek-nt35532.o' \
		>> drivers/gpu/drm/panel/Makefile
	grep -q "config DRM_PANEL_NOVATEK_NT35532" drivers/gpu/drm/panel/Kconfig || \
	cat "$srcdir/panel-novatek-nt35532.kconfig" >> drivers/gpu/drm/panel/Kconfig
	# qcom-pon.c: upstream 6.12 + phoenix poweroff handler (programs PON
	# shutdown type before PS_HOLD drop; without it poweroff reboots).
	cp "$srcdir/qcom-pon.c" drivers/power/reset/qcom-pon.c
	# ov13850.c: phoenix rear camera driver (mainline-style; ALL register
	# tables verbatim from the stock vendor libmmcamera_ov13850.so decode
	# — r61: 0x0103 singleton + 50 ms + 217-entry init, six per-mode
	# tables, per-mode link freqs 300/320/600 MHz, 4-lane CSI2; not
	# upstream). Wired like the panel driver.
	cp "$srcdir/ov13850.c" drivers/media/i2c/
	grep -q "CONFIG_VIDEO_OV13850" drivers/media/i2c/Makefile || \
	echo 'obj-$(CONFIG_VIDEO_OV13850) += ov13850.o' \
		>> drivers/media/i2c/Makefile
	grep -q "config VIDEO_OV13850" drivers/media/i2c/Kconfig || \
	cat "$srcdir/ov13850.kconfig" >> drivers/media/i2c/Kconfig
	# camss-msm8939-driver.patch + msm8939-camss-dtsi.patch are applied
	# by default_prepare above (abluild auto-applies *.patch).
	# qcom,msm8939-camss.yaml: binding doc for the new compatible.
	cp "$srcdir/qcom-msm8939-camss.yaml" \
		Documentation/devicetree/bindings/media/
	# a5xx needs its firmware in initramfs (mkinitfs picks up
	# MODULE_FIRMWARE; a6xx already declares its own, a5xx does not).
	grep -q 'qcom/a420_pm4.fw' drivers/gpu/drm/msm/adreno/a5xx_gpu.c || \
	printf '%s\n' 'MODULE_FIRMWARE("qcom/a420_pm4.fw");' 'MODULE_FIRMWARE("qcom/a420_pfp.fw");' \
		>> drivers/gpu/drm/msm/adreno/a5xx_gpu.c
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 HOSTLDFLAGS="-fuse-ld=lld" \
		KBUILD_BUILD_VERSION=$((pkgrel + 1 ))
}

package() {
	mkdir -p "$pkgdir"/boot

	_install_targets="modules_install dtbs_install"

	if [ -e "$builddir/arch/$_carch/boot/vmlinuz.efi" ]; then
		# ZBOOT EFI decompressor for EFI booting
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
			"$pkgdir/boot/linux.efi"

		# Old GZIP'd kernel image for boot.img compatibility
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
			"$pkgdir/boot/vmlinuz"
	elif [ "$_carch" = "arm64" ]; then
		echo "WARNING: CONFIG_ZBOOT not enabled!"
		install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
			"$pkgdir/boot/vmlinuz"
	else
		_install_targets="zinstall modules_install dtbs_install"
	fi

	make $_install_targets \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release
}

