+/*
+ * OV13850 linearization/BLC (chromatix TL84 normal light; the six chromatix
+ * light-condition tables are identical).  Part A: 17 words at 0x37c, channel
+ * order R, Gb, B, Gr; each point-slope word is Pnext[11:0] | Pcur[27:16].
+ * Part B: 36-word DMI curve LUT (bank BLACK_LUT_RAM_BANK0), nine segments in
+ * the order R, Gr, Gb, B; each word is base[11:0] | Q9(delta)[17:0] << 12.
+ * The curve is "output = max(0, input - black level)" in the 12-bit
+ * chromatix domain: black level {R,Gr,Gb,B} = {69,66,65,69}.
+ */
+static const u32 vfe_ov13850_blc_cfg[] = {
+	0x00000000,	/* lutBankSel = 0 (BLACK_LUT_RAM_BANK0) */
+	0x00c20045, 0x01be0140, 0x0433023c, 0x0e070c10,	/* R  */
+	0x02380041, 0x06280430, 0x0a170820, 0x0e070c0f,	/* Gb */
+	0x023c0045, 0x062a0433, 0x0a190822, 0x0e070c10,	/* B  */
+	0x02390042, 0x06280431, 0x0a180820, 0x0e070c0f,	/* Gr */
+};
+
+static const u32 vfe_ov13850_blc_lut[] = {
+	0x00000000, 0x00000000, 0x00000000, 0x00000000,
+	0x00200000, 0x00200000, 0x00200000, 0x00200000,
+	0x0020007d, 0x002001f7, 0x002001f7, 0x002001f7,
+	0x002000fb, 0x002003ef, 0x002003ef, 0x002003ee,
+	0x00200179, 0x002005e6, 0x002005e7, 0x002005e5,
+	0x002001f7, 0x002007de, 0x002007df, 0x002007dd,
+	0x002003ee, 0x002009d6, 0x002009d6, 0x002009d4,
+	0x00200bcb, 0x00200bcd, 0x00200bce, 0x00200bcb,
+	0x00200dc2, 0x00200dc5, 0x00200dc6, 0x00200dc2,
+};
