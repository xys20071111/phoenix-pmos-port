+/*
+ * Push a 32-bit DMI table into a VFE memory bank.  This is the same sequence
+ * the vendor kernel performs for VFE_WRITE_DMI_32BIT (msm_isp_util.c):
+ * select auto-increment + bank, address 0, stream the words to DMI_DATA_LO,
+ * then deselect the memory.  Static configuration only: no banking games, no
+ * calls while streaming or from the IRQ handler.
+ */
+static void vfe_dmi_write32(struct vfe_device *vfe, u32 bank,
+			    const u32 *tbl, int n)
+{
+	int i;
+
+	writel_relaxed(VFE_0_DMI_CFG_DEFAULT | bank,
+		       vfe->base + VFE_0_DMI_CFG);
+	writel_relaxed(0, vfe->base + VFE_0_DMI_ADDR);
+	wmb();
+	for (i = 0; i < n; i++)
+		writel_relaxed(tbl[i], vfe->base + VFE_0_DMI_DATA_LO);
+	wmb();
+	writel_relaxed(VFE_0_DMI_CFG_DEFAULT, vfe->base + VFE_0_DMI_CFG);
+	writel_relaxed(0, vfe->base + VFE_0_DMI_ADDR);
+}
+
+/* Linearization/BLC: curve LUT (DMI) first, then the knee-point block. */
+static void vfe_set_linearization_cfg(struct vfe_device *vfe)
+{
+	unsigned int i;
+
+	vfe_dmi_write32(vfe, VFE_0_BLACK_LUT_BANK0, vfe_ov13850_blc_lut,
+			ARRAY_SIZE(vfe_ov13850_blc_lut));
+
+	for (i = 0; i < ARRAY_SIZE(vfe_ov13850_blc_cfg); i++)
+		writel_relaxed(vfe_ov13850_blc_cfg[i],
+			       vfe->base + VFE_0_LINEARIZATION_CFG + 4 * i);
+}
+
+#define VFE_FULL_ISP_MODULE_CFG_B1	(VFE_0_MODULE_CFG_DEMUX | \
+					 VFE_0_MODULE_CFG_DEMOSAIC | \
+					 VFE_0_MODULE_CFG_WHITE_BALANCE | \
+					 VFE_0_MODULE_CFG_SCALE_ENC | \
+					 VFE_0_MODULE_CFG_CROP_ENC)
+#define VFE_FULL_ISP_MODULE_CFG_B2	(VFE_FULL_ISP_MODULE_CFG_B1 | \
+					 VFE_0_MODULE_CFG_COLOR_CORRECT | \
+					 VFE_0_MODULE_CFG_CHROMA_ENHANCE)
+
+/* Q7 ratio helper (a/b), used for the demosaic interpolation normalisers. */
+static u32 vfe_q7_ratio(u32 a, u32 b)
+{
+	if (!b)
+		return 0x80;
+
+	return DIV_ROUND_CLOSEST(a * 0x80, b);
+}
+
+/* Demosaic: mix config + interpolation normalisers + classifier + interp G. */
+static void vfe_set_demosaic_cfg(struct vfe_device *vfe)
+{
+	u32 rg, bg, gr, gb;
+	unsigned int i;
+
+	/* mix config: all fields 0 = stock defaults (cosited/abcc/flush off) */
+	vfe_reg_clr(vfe, VFE_0_DEMOSAIC_MIX_CFG, 0xfffffff0);
+
+	/*
+	 * Stock feeds the same AWB ratios to the demosaic interpolation
+	 * normalisers and to the white-balance block; pix_demosaic_interp=1
+	 * forces unity normalisers for A/B of a possible double gain.
+	 */
+	if (pix_demosaic_interp) {
+		rg = bg = gr = gb = 0x80;
+	} else {
+		rg = vfe_q7_ratio(pix_wb_gain_r, pix_wb_gain_g);
+		bg = vfe_q7_ratio(pix_wb_gain_b, pix_wb_gain_g);
+		gr = vfe_q7_ratio(pix_wb_gain_g, pix_wb_gain_r);
+		gb = vfe_q7_ratio(pix_wb_gain_g, pix_wb_gain_b);
+	}
+	writel_relaxed((rg & 0x1ff) | ((bg & 0x1ff) << 15),
+		       vfe->base + VFE_0_DEMOSAIC_INTERP_WB_0);
+	writel_relaxed((gr & 0x1ff) | ((gb & 0x1ff) << 15),
+		       vfe->base + VFE_0_DEMOSAIC_INTERP_WB_1);
+
+	for (i = 0; i < ARRAY_SIZE(vfe_demosaic_classifier); i++)
+		writel_relaxed(vfe_demosaic_classifier[i],
+			       vfe->base + VFE_0_DEMOSAIC_CLASSIFIER + 4 * i);
+
+	writel_relaxed(0x0000ff00, vfe->base + VFE_0_DEMOSAIC_INTERP_G_0);
+	writel_relaxed(0x0001a020, vfe->base + VFE_0_DEMOSAIC_INTERP_G_1);
+}
+
+/* White balance: ch0 = G, ch1 = B, ch2 = R, 9-bit Q7 gains. */
+static void vfe_set_wb_cfg(struct vfe_device *vfe)
+{
+	u32 val = ((pix_wb_gain_r & 0x1ff) << 18) |
+		  ((pix_wb_gain_b & 0x1ff) << 9) |
+		  (pix_wb_gain_g & 0x1ff);
+
+	writel_relaxed(val, vfe->base + VFE_0_WB_CFG);
+}
+
+/* Colour correction: 12-bit signed coefficients, one per word (GBR order). */
+static void vfe_set_cc_cfg(struct vfe_device *vfe)
+{
+	u32 qf = pix_cc_qfactor & 0x3;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(vfe_cc_tl84); i++) {
+		u32 val;
+
+		if (pix_cc_mode)
+			val = (vfe_cc_tl84[i] << qf) & 0xfff;
+		else
+			val = (i % 4 == 0) ? ((0x80 << qf) & 0xfff) : 0;
+
+		writel_relaxed(val, vfe->base + VFE_0_COLOR_CORRECT_CFG + 4 * i);
+	}
+	writel_relaxed(0, vfe->base + VFE_0_COLOR_CORRECT_CFG + 4 * 9);
+	writel_relaxed(0, vfe->base + VFE_0_COLOR_CORRECT_CFG + 4 * 10);
+	writel_relaxed(0, vfe->base + VFE_0_COLOR_CORRECT_CFG + 4 * 11);
+	writel_relaxed(qf, vfe->base + VFE_0_COLOR_CORRECT_CFG + 4 * 12);
+}
+
+/* Chroma enhance / RGB->YUV: 9 words (chromatix TL84 or generic fallback). */
+static void vfe_set_chroma_enh_cfg(struct vfe_device *vfe)
+{
+	const u32 *tab = pix_ce_mode ? vfe_cv_tl84 : vfe_cv_generic;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(vfe_cv_tl84); i++)
+		writel_relaxed(tab[i],
+			       vfe->base + VFE_0_CHROMA_ENHANCE_CFG + 4 * i);
+}
+
+/* Stage-B block programming; called from vfe_set_module_cfg() before the
+ * module enable word is written (all writes latch at the final reg_update,
+ * so they can be grouped here; the module bits are still 0 at this point).
+ */
+static bool vfe_bayer_blc_enabled(void)
+{
+	return pix_linearization || pix_full_isp >= 3;
+}
+
+static void vfe_set_bayer_full_isp_cfg(struct vfe_device *vfe)
+{
+	if (pix_full_isp >= 1) {
+		vfe_set_demosaic_cfg(vfe);
+		vfe_set_wb_cfg(vfe);
+	}
+	if (pix_full_isp >= 2) {
+		vfe_set_cc_cfg(vfe);
+		vfe_set_chroma_enh_cfg(vfe);
+	}
+	if (vfe_bayer_blc_enabled())
+		vfe_set_linearization_cfg(vfe);
+}
