+/*
+ * Stage-B full ISP for the raw-bayer PIX path (see
+ * camera-ref/tools/r76/full_isp_stageB.md).  pix_full_isp defaults to 2;
+ * 0 restores the legacy demux-only path.  All are runtime-switchable and
+ * a fresh STREAMON latches them (vfe_enable_output samples the values):
+ *
+ *   pix_full_isp      0 = demux only (legacy pseudo-YUV path; 2 = default)
+ *                     1 = B1: demux + demosaic + white balance (hang bisection)
+ *                     2 = B2 (DEFAULT): + colour correction + chroma-enhance
+ *                         (real RGB -> YCbCr, NV12 output is true YUV)
+ *                     3 = B2 + linearization/BLC (module bit 0; see below)
+ *   pix_linearization 1 = enable the LINEARIZATION/BLC block independently of
+ *                     the colour stages (works on the demux-only Stage A path
+ *                     too: module word 0x08800005).  It subtracts the OV13850
+ *                     sensor black level {R,Gr,Gb,B}={69,66,65,69} (12-bit
+ *                     domain), which is the fix for the chroma pedestal.
+ *   pix_full_isp_cfg  raw MODULE_CFG word override for the bayer branch
+ *                     (0 = automatic: B1/B2 word chosen by pix_full_isp;
+ *                     pix_module_cfg above still takes precedence).  A
+ *                     raw word is used verbatim, so BLC bit0 must then be
+ *                     included by hand (e.g. 0x08822815 for B2+BLC)
+ *   pix_wb_gain_{r,g,b}  WB block gains, 9-bit Q7 (0x80 = 1.0); defaults are
+ *                     the r72 white-wall calibration (R=1.92, B=1.34, G=1.0)
+ *   pix_demosaic_interp  0 = demosaic interpolation normalisers derived from
+ *                     the WB gains (stock feeds the same AWB ratios to both),
+ *                     1 = unity (use if B1 looks over-bright/over-saturated)
+ *   pix_cc_mode       0 = identity colour matrix (debug), 1 = OV13850 TL84
+ *   pix_cc_qfactor    0..3 extra coefficient precision (coefQFactor); 0 keeps
+ *                     the stock encoding (C = round(c * 128))
+ *   pix_ce_mode       0 = generic BT.601-style matrix (neutral chroma),
+ *                     1 = OV13850 TL84 matrix (default, real device tuning)
+ *
+ * LINEARIZATION/BLC (module bit 0) needs two parts, both written here while
+ * the block is still disabled:
+ *   a) the 17-word knee-point block at 0x37c (plain writes), and
+ *   b) the 36-word curve LUT pushed through the VFE DMI engine (bank
+ *      BLACK_LUT_RAM_BANK0 = 0x1, DMI registers 0x910/0x914/0x91c) with a
+ *      small writel helper - no DMA, no bank toggling (static table).
+ * Enabling bit 0 without both parts would fetch an undefined bank (black or
+ * garbage), so they are always programmed together.  Note that the curve is
+ * in the 12-bit chromatix domain (10-bit << 2): the raw black levels are used
+ * as-is, never divided by 4.  DMI is only touched from the stream-on path
+ * (never per-frame, never in the ISR).
+ */
+static uint pix_full_isp = 2;	/* B2 full ISP default, 0 = Stage A */
+module_param_named(pix_full_isp, pix_full_isp, uint, 0644);
+static uint pix_full_isp_cfg;
+module_param_named(pix_full_isp_cfg, pix_full_isp_cfg, uint, 0644);
+static uint pix_wb_gain_r = 246;	/* 1.92 */
+static uint pix_wb_gain_g = 128;	/* 1.00 */
+static uint pix_wb_gain_b = 172;	/* 1.34 */
