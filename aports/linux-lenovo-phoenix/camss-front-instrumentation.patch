+/*
+ * r77-F front-camera diagnostics (temporary, drop before upstreaming).
+ *
+ * Override the CSI-2 data-lane map of CSIPHY1 without a DT rebuild.
+ * csiphy1_lane_pos packs up to four lane positions as nibbles (lane0 =
+ * bits[3:0], lane1 = bits[7:4], ...); 0xffffffff keeps the parsed DT
+ * value.  csiphy1_lane_cnt may only *reduce* the parsed lane count (the
+ * lane array is sized by the DT parse).  Defaults keep today's behaviour.
+ *
+ * A/B pairs: <0 2> pos=0x20, <0 1> pos=0x10, <1 2> pos=0x21,
+ * <0 3> pos=0x30, <2 3> pos=0x32 (pair with csid_lane_assign =
+ * pos0 | pos1 << 4).
+ */
+static uint csiphy1_lane_pos = 0xffffffff;
+module_param_named(csiphy1_lane_pos, csiphy1_lane_pos, uint, 0644);
+static uint csiphy1_lane_cnt;
+module_param_named(csiphy1_lane_cnt, csiphy1_lane_cnt, uint, 0644);
+
+static void csiphy_apply_lane_override(struct csiphy_device *csiphy,
+				       struct csiphy_config *cfg)
+{
+	struct csiphy_lanes_cfg *lc;
+	unsigned int i, n;
+
+	if (csiphy->id != 1 || !cfg->csi2)
+		return;
+
+	lc = &cfg->csi2->lane_cfg;
+	n = lc->num_data;
+
+	/* The lane array is sized by the DT parse: only reducing is safe. */
+	if (csiphy1_lane_cnt && csiphy1_lane_cnt < n) {
+		n = csiphy1_lane_cnt;
+		lc->num_data = n;
+	}
+
+	if (csiphy1_lane_pos == 0xffffffff)
+		return;
+
+	for (i = 0; i < n && i < 4; i++)
+		lc->data[i].pos = (csiphy1_lane_pos >> (4 * i)) & 0xf;
+
+	dev_info(csiphy->camss->dev,
+		 "CSIPHY%u lane override: num_data=%u positions=%u,%u,%u,%u (param=0x%08x)\n",
+		 csiphy->id, n,
+		 n > 0 ? lc->data[0].pos : 0,
+		 n > 1 ? lc->data[1].pos : 0,
+		 n > 2 ? lc->data[2].pos : 0,
+		 n > 3 ? lc->data[3].pos : 0,
+		 csiphy1_lane_pos);
+}
