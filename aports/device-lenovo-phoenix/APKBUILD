# Reference: <https://postmarketos.org/devicepkg>
#
# phoenix device package, split out of device-qcom-msm8916 (2026-10): carries
# every phoenix-local change that used to live as local modifications of the
# generic package (audio init + udev rules, a420 GPU firmware list package,
# modem stack OpenRC wiring). Content and pkgver/pkgrel numbering continue
# from device-qcom-msm8916 pkgver=8 pkgrel=9 so BUILD.md history maps 1:1.
maintainer="Tom Xue <xys20071111@hotmail.com>"
pkgname=device-lenovo-phoenix
pkgdesc="Lenovo PHAB Plus (PB1-770N, MSM8939)"
pkgver=8
pkgrel=9
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-qcom-adreno-a420
	firmware-lenovo-phoenix-venus
	firmware-lenovo-phoenix-modem
	soc-qcom-msm8916-rproc
	q6voiced
	msm-modem
	msm-modem-uim-selection
	modemmanager
	alsa-utils
	soc-qcom-msm8916-ucm
	firmware-qcom-db410c-wcnss-nv
	msm-firmware-loader
	postmarketos-base
	soc-qcom-msm8916
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	30-gpu-firmware.files
	msm8916-audio-init.sh
	90-msm8916-audio.rules
"
subpackages="
	$pkgname-kernel-extlinux:kernel_extlinux
	$pkgname-kernel-efi:kernel_efi
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# HACK: For devices that don't have a nv file in persist we
	# temporarily link the db410c file to the expected location.
	# It will be overriden if the file is in persist or when user
	# installs the device-specific firmware packages.
	mkdir -p "$pkgdir"/usr/lib/firmware/wlan/prima/
	ln -s /usr/lib/firmware/qcom/apq8016/WCNSS_qcom_wlan_nv_sbc.bin \
		"$pkgdir"/usr/lib/firmware/wlan/prima/WCNSS_qcom_wlan_nv.bin

	# Adreno a420 firmware into initramfs (same pattern as db820c's
	# 30-gpu-firmware.files): msm probes display+GPU in initramfs stage,
	# but the firmware only exists on rootfs -> early probe always fails.
	install -Dm644 "$srcdir/30-gpu-firmware.files" \
		"$pkgdir/usr/share/mkinitfs/files/30-gpu-firmware.files"

	# msm8916 audio defaults: udev applies proven mixer set when the
	# sound card appears (init-agnostic, survives reflash).
	# UCM comes from soc-qcom-msm8916-ucm (msm8916-mainline
	# alsa-ucm-conf, dir ucm2/msm8916 == card name).
	install -Dm755 "$srcdir/msm8916-audio-init.sh" \
		"$pkgdir/usr/libexec/msm8916-audio-init.sh"
	install -Dm644 "$srcdir/90-msm8916-audio.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-msm8916-audio.rules"

	# OpenRC boot wiring for the phoenix modem stack:
	# modemmanager, rmtfs, msm-modem-uim-selection used to have to be
	# enabled by hand on every flash (see MODEM.md): no pulled-in
	# package enables them -- on the current edge mirror the -openrc
	# subpackages of msm-modem/rmtfs ship conf+initd with no rc-update
	# scripts, and postmarketos-base-ui does not enable modemmanager on
	# fbkeyboard. Ship the runlevel symlinks like phoenix-usbgadget does
	# for `local`: deterministic on fresh installs, no-op on a rootfs
	# that already has them. Runlevel: `default` for all three,
	# following upstream soc-qcom-modem-openrc (uim-selection's initd
	# does `need rmtfs;` `before modemmanager`, same-runlevel
	# semantics). q6voiced is kept upstream-managed via
	# soc-qcom-msm8916-rproc-openrc. systemd rootfs variants ignore
	# /etc/runlevels entirely.
	install -d "$pkgdir"/etc/runlevels/default
	ln -s /etc/init.d/modemmanager \
		"$pkgdir"/etc/runlevels/default/modemmanager
	ln -s /etc/init.d/rmtfs \
		"$pkgdir"/etc/runlevels/default/rmtfs
	ln -s /etc/init.d/msm-modem-uim-selection \
		"$pkgdir"/etc/runlevels/default/msm-modem-uim-selection
}

kernel_extlinux() {
	pkgdesc="Use lk2nd to boot via extlinux.conf"
	depends="linux-lenovo-phoenix"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_efi() {
	pkgdesc="Use U-Boot to boot via EFI"
	depends="linux-lenovo-phoenix systemd-boot"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}
