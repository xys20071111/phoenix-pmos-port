# Reference: <https://postmarketos.org/deviceinfo>
# HISTORICAL DRAFT (2026-10 早期): "先通用后拆分"的原始设想，2026-10-24 已落地，
# 独立设备包见 aports/device-lenovo-phoenix/ + pmaports device/testing/device-lenovo-phoenix/
# （当时"无需自定义包"的结论针对的是 deviceinfo 层面；设备包最终仍拆出，是为了
# 把收 runlevel/mkinitfs/音频 wiring 从通用包上摘下来）。本文件留作历史。
# Draft for Lenovo PHAB Plus PB1-770N, based on device-qcom-msm8916 + kiwi

deviceinfo_format_version="0"
deviceinfo_name="Lenovo PHAB Plus"
deviceinfo_manufacturer="Lenovo"
deviceinfo_codename="lenovo-phoenix"
deviceinfo_year="2015"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_drm="true"
deviceinfo_external_storage="true"
deviceinfo_getty="ttyMSM0;115200"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="1920"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_kernel_cmdline="earlycon console=ttyMSM0,115200"
deviceinfo_generate_lk2nd="true"
deviceinfo_lk2nd="msm8916"

# initfs
deviceinfo_modules_initfs=""

# extlinux for lk2nd
deviceinfo_dtb_extlinux="qcom/msm8939-lenovo-phoenix"
deviceinfo_generate_extlinux_config_extlinux="true"
deviceinfo_boot_filesystem_extlinux="ext2"
